{
  "name": "gonotes-editor",
  "private": true,
  "description": "The code in the browser: the live markdown editor and the page, bundled into ../web/static/editor.js and app.js",
  "scripts": {
    "build": "npm run build:editor && npm run build:app",
    "build:editor": "esbuild src/editor.js --bundle --minify --format=iife --target=es2020 --outfile=../web/static/editor.js",
    "build:app": "esbuild src/app/main.js --bundle --format=iife --target=es2020 --sourcemap --sources-content=true --outfile=../web/static/app.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@replit/codemirror-vim": "6.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
